---
// GitHub Pages serves this single page for every missing URL. It renders both languages and shows
// one: Italian under /it/…, English otherwise (and without JS). The head script sets <html lang>
// before first paint, so the other version never flashes.
import Button from '../components/Button.astro';
import NotFoundArt from '../components/NotFoundArt.astro';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const en = useTranslations('en');
const it = useTranslations('it');

const versions = [
  { lang: 'en', t: en, home: '/', visibility: '[html[lang=it]_&]:hidden' },
  { lang: 'it', t: it, home: '/it/', visibility: 'hidden [html[lang=it]_&]:block' },
];

// clone: every wrapped line gets the full cyan→magenta gradient
const gradient =
  'box-decoration-clone bg-linear-to-r/srgb from-accent-bright to-magenta bg-clip-text text-transparent';
---

<BaseLayout title={`404 — ${en('notFound.title')}`} description={en('notFound.title')} errorPage>
  <script
    slot="head"
    is:inline
    define:vars={{ title: `404 — ${it('notFound.title')}`, themeLabel: it('toggle.theme') }}
  >
    if (/^\/it(\/|$)/.test(location.pathname)) {
      document.documentElement.lang = 'it';
      document.title = title;
      addEventListener('DOMContentLoaded', () => {
        document.getElementById('theme-toggle')?.setAttribute('aria-label', themeLabel);
      });
    }
  </script>

  <section
    class="mx-auto grid max-w-page grid-cols-1 items-center gap-[clamp(24px,4vw,64px)] px-gutter pt-[clamp(32px,6vw,72px)] pb-[clamp(56px,8vw,110px)] md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
  >
    {
      versions.map(({ lang, t, home, visibility }) => (
        <div lang={lang} class={visibility}>
          <p class="mb-5.5 inline-flex items-center gap-2.5 font-mono text-[13px] tracking-[.06em] text-ink-soft uppercase text-shadow-halo">
            <span class="size-2 rounded-full bg-magenta shadow-[0_0_0_4px_rgba(240,70,138,.18)]" />
            {t('notFound.eyebrow')}
          </p>
          <h1 class="font-head text-display font-bold text-shadow-halo">404</h1>
          <p class="mt-5.5 mb-6.5 font-head text-role leading-[1.3] font-medium">
            <span class={gradient}>{t('notFound.lead')}</span>
          </p>
          <p class="max-w-[52ch] text-ink-soft text-shadow-halo">{t('notFound.text')}</p>
          <div class="mt-8">
            <Button href={home}>{t('notFound.home')}</Button>
          </div>
        </div>
      ))
    }
    <div class="order-first md:order-none">
      <NotFoundArt />
    </div>
  </section>
</BaseLayout>
