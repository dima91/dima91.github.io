---
// my-favourite-wedding: an invitation and a photo joined by two rings
import { pa } from './paint';
---

<g transform="rotate(-6 75 60)">
  <rect class={pa.panel} x="42" y="22" width="66" height="76" rx="6" />
  <rect class={pa.fillA} x="52" y="34" width="30" height="5" rx="2.5" />
  <rect class={pa.dim} x="52" y="46" width="46" height="3" rx="1.5" />
  <rect class={pa.dim} x="52" y="54" width="38" height="3" rx="1.5" />
  <rect class:list={[pa.strokeM, pa.dash]} x="52" y="68" width="46" height="18" rx="3" />
  <path class={pa.dotsM} d="M62 77h.01M70 77h.01M78 77h.01M86 77h.01" />
</g>
<circle class={pa.ringA} cx="150" cy="60" r="22" />
<circle class={pa.ringM} cx="172" cy="60" r="22" />
<g transform="rotate(6 245 60)">
  <rect class={pa.panel} x="212" y="24" width="66" height="72" rx="6" />
  <rect class={pa.frame} x="220" y="32" width="50" height="44" rx="3" />
  <circle class={pa.fillM} cx="257" cy="44" r="5" />
  <path class:list={[pa.fillA, pa.soft]} d="M220 76l16-20 10 12 8-8 16 16z" />
  <rect class={pa.dim} x="220" y="84" width="30" height="3" rx="1.5" />
</g>
