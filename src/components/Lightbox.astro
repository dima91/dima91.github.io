---
import Chevron from '../assets/icons/chevron.svg';
import Close from '../assets/icons/close.svg';
import { getLang, useTranslations } from '../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));

/** Round button on the veil, 44px wide for touch. */
const control =
  'pointer-events-auto inline-grid size-11 cursor-pointer place-items-center rounded-full border-[1.5px] border-line bg-surface text-ink transition-colors duration-200 hover:border-ink-soft';
---

<!-- Full-page photo preview: one per page, opened by any element with a `data-lightbox` attribute
     (see src/data/lightbox.ts). The dialog fills the viewport and is itself the blurred veil over the
     page, rather than its ::backdrop, which does not get the theme colours in older browsers.
     The photo is sized from its pixel size (--w, --h, set by the script), so its frame is in place
     before it loads: never larger than the photo itself or than the space inside the padding. -->
<dialog
  data-lightbox-dialog
  aria-label={t('lightbox.label')}
  class="fixed inset-0 m-0 size-full max-h-none max-w-none place-items-center bg-bg/55 px-(--pad-x) py-(--pad-y) text-ink backdrop-blur-lg transition-opacity duration-200 [--pad-x:clamp(16px,5vw,64px)] [--pad-y:72px] backdrop:bg-transparent open:grid motion-reduce:transition-none sm:[--pad-x:64px] starting:open:opacity-0"
>
  <img
    data-lightbox-photo
    alt=""
    sizes="100vw"
    class="aspect-[calc(var(--w)/var(--h))] w-[min(100%,calc(var(--w)*1px),calc((100dvh-2*var(--pad-y))*var(--w)/var(--h)))] rounded-card bg-surface"
  />
  <button type="button" data-lightbox-close aria-label={t('lightbox.close')} class:list={[control, 'absolute top-3.5 right-3.5']}>
    <Close aria-hidden="true" />
  </button>
  <!-- Slideshow controls, shown with more than one photo. On phones they are a row under the photo;
       from sm the arrows sit beside it, in the padding. Clicks between them fall through to the veil. -->
  <div
    data-lightbox-nav
    hidden
    class="pointer-events-none absolute inset-x-0 bottom-3.5 flex items-center justify-center gap-3 sm:contents"
  >
    <button
      type="button"
      data-lightbox-prev
      aria-label={t('lightbox.prev')}
      class:list={[control, 'sm:absolute sm:top-1/2 sm:left-2.5 sm:-translate-y-1/2']}
    >
      <Chevron aria-hidden="true" class="rotate-180" />
    </button>
    <p
      data-lightbox-counter
      aria-live="polite"
      class="min-w-16 rounded-full border-[1.5px] border-line bg-surface px-3 py-1 text-center font-mono text-[13px] tabular-nums sm:absolute sm:bottom-5 sm:left-1/2 sm:-translate-x-1/2"
    >
    </p>
    <button
      type="button"
      data-lightbox-next
      aria-label={t('lightbox.next')}
      class:list={[control, 'sm:absolute sm:top-1/2 sm:right-2.5 sm:-translate-y-1/2']}
    >
      <Chevron aria-hidden="true" />
    </button>
  </div>
</dialog>

<script>
  import type { LightboxPhoto } from '../data/lightbox';

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]')!;
  const nav = dialog.querySelector<HTMLElement>('[data-lightbox-nav]')!;
  const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
  let photo = dialog.querySelector<HTMLImageElement>('[data-lightbox-photo]')!;
  let photos: LightboxPhoto[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  /** Shows photo `i`, wrapping around at both ends. */
  function show(i: number) {
    index = (i + photos.length) % photos.length;
    const { src, srcset, width, height, alt } = photos[index];

    // a fresh <img> each time: one that changes source keeps showing the previous picture,
    // stretched to the new frame, until the next one has loaded
    const next = photo.cloneNode() as HTMLImageElement;
    next.style.setProperty('--w', String(width));
    next.style.setProperty('--h', String(height));
    next.alt = alt;
    next.srcset = srcset;
    next.src = src;
    photo.replaceWith(next);
    photo = next;

    counter.textContent = `${index + 1} / ${photos.length}`;

    // have the following photo ready
    if (photos.length > 1) {
      const ahead = photos[(index + 1) % photos.length];
      const preload = new Image();
      preload.sizes = next.sizes;
      preload.srcset = ahead.srcset;
      preload.src = ahead.src;
    }
  }

  /** Moves through the slideshow, if there is one. */
  function step(by: number) {
    if (photos.length > 1) show(index + by);
  }

  document.addEventListener('click', (event) => {
    const trigger = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-lightbox]') : null;
    // a modified click keeps what the element does by itself: a link opens its photo in a new tab
    if (!trigger || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();

    photos = JSON.parse(trigger.dataset.lightbox!);
    opener = trigger;
    nav.hidden = photos.length < 2;
    show(0);
    dialog.showModal();
  });

  // a click on the veil around the photo lands on the dialog itself
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());

  // Also after Esc. Browsers that do not focus a link on click cannot return the focus to it by themselves.
  dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));

  dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => step(-1));
  dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => step(1));
  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') step(-1);
    else if (event.key === 'ArrowRight') step(1);
  });

  // Swipe on touch screens. The listeners are passive, so pinch-zoom and panning stay with the
  // browser, and a swipe counts only while the page is not zoomed in.
  let touch: { x: number; y: number } | null = null;
  dialog.addEventListener(
    'touchstart',
    ({ touches }) => {
      touch = touches.length === 1 ? { x: touches[0].clientX, y: touches[0].clientY } : null;
    },
    { passive: true },
  );
  dialog.addEventListener(
    'touchend',
    ({ changedTouches }) => {
      const start = touch;
      touch = null;
      if (!start || (window.visualViewport?.scale ?? 1) > 1) return;
      const dx = changedTouches[0].clientX - start.x;
      const dy = changedTouches[0].clientY - start.y;
      // mostly horizontal, and longer than a tap that slipped
      if (Math.abs(dx) > 48 && Math.abs(dx) > 2 * Math.abs(dy)) step(dx < 0 ? 1 : -1);
    },
    { passive: true },
  );
</script>
