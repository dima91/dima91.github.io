---
import { sectionNumber, type SectionId } from '../data/sections';

interface Props {
  id: SectionId;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-page border-t border-line px-gutter py-[clamp(56px,8vw,104px)]">
  <header class="reveal mb-[clamp(32px,5vw,56px)] flex items-baseline gap-4.5 text-shadow-halo">
    <span class="font-mono text-[14px] text-accent">{sectionNumber(id)}</span>
    <h2 class="font-head text-h2 font-bold">{title}</h2>
  </header>
  <slot />
</section>
