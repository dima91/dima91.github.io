---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';
import { getLang, useTranslations, type UiKey } from '../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));

const stats: { value: string; label: UiKey }[] = [
  { value: '9+', label: 'stats.years' },
  { value: '4', label: 'stats.pubs' },
  { value: '3', label: 'stats.plugtests' },
];

const btn =
  'inline-block rounded-full border-[1.5px] border-ink px-6.5 py-3.25 text-[16px] font-medium transition-[translate,background-color,color] duration-200 hover:-translate-y-0.5';
---

<section
  id="about"
  class="mx-auto grid max-w-page grid-cols-1 items-center gap-[clamp(24px,4vw,64px)] overflow-x-clip px-gutter pt-[clamp(32px,6vw,72px)] pb-[clamp(56px,8vw,110px)] md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
>
  <div>
    <p
      class="mb-5.5 inline-flex items-center gap-2.5 font-mono text-[13px] tracking-[.06em] text-ink-soft uppercase text-shadow-halo"
    >
      <span class="size-2 rounded-full bg-accent-bright shadow-[0_0_0_4px_rgba(6,182,212,.18)]"></span>
      {t('hero.place')}
    </p>
    <h1 class="font-head text-display font-bold whitespace-nowrap text-shadow-halo">Luca<br />Di Mauro</h1>
    <!-- gradient text: no halo, it would show through the transparent glyphs -->
    <p
      class="mt-5.5 mb-6.5 inline-block bg-linear-to-r/srgb from-accent-bright to-magenta bg-clip-text font-head text-role font-medium text-transparent"
    >
      Software Engineer
    </p>
    <p class="max-w-[52ch] text-ink-soft text-shadow-halo">{t('hero.bio1')}</p>
    <p class="mt-3.5 max-w-[52ch] text-ink-soft text-shadow-halo">{t('hero.bio2')}</p>
    <div class="mt-8 mb-10 flex flex-wrap gap-3">
      <a href="#contact" class:list={[btn, 'bg-ink text-bg']}>{t('hero.cta.contact')}</a>
    </div>
    <ul aria-label={t('stats.label')} class="flex flex-wrap gap-x-[clamp(24px,4vw,44px)] gap-y-3.5 border-t border-line pt-6.5">
      {
        stats.map(({ value, label }) => (
          <li class="flex flex-col text-shadow-halo">
            <strong class="font-head text-[34px] leading-[1.1] tracking-[-.02em]">{value}</strong>
            <span class="text-[13px] text-ink-soft">{t(label)}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- before: soft cyan/magenta glow behind the illustration -->
  <div
    class="relative order-first before:absolute before:inset-[10%_5%_5%_12%] before:bg-[radial-gradient(closest-side,var(--color-glow-a),var(--color-glow-b)_60%,transparent_80%)] before:blur-[30px] md:order-none"
  >
    <Image
      src={hero}
      alt={t('hero.alt')}
      widths={[480, 720, 960, 1440, hero.width]}
      sizes="(min-width: 961px) min(56vw, 720px), 100vw"
      priority
      class="relative w-full animate-float motion-reduce:animate-none md:-mr-[15%] md:w-[115%] md:max-w-none"
    />
  </div>
</section>
