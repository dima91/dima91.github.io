---
import { sections } from '../data/sections';
import { getLang, useTranslations } from '../i18n/ui';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const t = useTranslations(getLang(Astro.currentLocale));

const links = sections.filter((id) => id !== 'contact');
const hasContact = sections.includes('contact');
---

<header
  data-header
  class="sticky top-0 z-20 flex items-center justify-between border-b border-transparent bg-nav px-[calc(var(--spacing-gutter)+64px)] py-3.5 backdrop-blur-md transition-colors duration-300 data-scrolled:border-line"
>
  <nav aria-label={t('nav.label')} class="flex-1">
    <!-- links need ~840px in Italian: shown from md, with the mockup spacing from lg -->
    <ul class="flex items-center gap-4 lg:gap-8">
      {
        links.map((id) => (
          <li class="hidden md:block">
            <a href={`#${id}`} class="text-[15px] whitespace-nowrap text-ink-soft transition-colors duration-200 hover:text-ink">
              {t(`nav.${id}`)}
            </a>
          </li>
        ))
      }
      {
        hasContact && (
          <li class="hidden md:block">
            <a
              href="#contact"
              class="rounded-full border-[1.5px] border-ink px-4 py-1.75 text-[15px] whitespace-nowrap text-ink transition-colors duration-200 hover:bg-ink hover:text-bg"
            >
              {t('nav.contact')}
            </a>
          </li>
        )
      }
      <li class="ml-auto flex items-center gap-2">
        <LangToggle />
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
