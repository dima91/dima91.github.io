---
import { sections, type SectionId } from '../data/sections';
import ThemeToggle from './ThemeToggle.astro';

const labels: Record<SectionId, string> = {
  about: 'About',
  experience: 'Experience',
  projects: 'Projects',
  skills: 'Skills',
  publications: 'Publications',
  contact: 'Contact',
};

const links = sections.filter((id) => id !== 'contact');
const hasContact = sections.includes('contact');
---

<header
  id="top"
  data-header
  class="sticky top-0 z-20 flex items-center justify-between border-b border-transparent bg-nav px-[calc(var(--spacing-gutter)+64px)] py-3.5 backdrop-blur-md transition-colors duration-300 data-scrolled:border-line"
>
  <nav aria-label="Main" class="flex-1">
    <ul class="flex items-center gap-[clamp(14px,3vw,32px)]">
      {
        links.map((id) => (
          <li class="hidden sm:block">
            <a href={`#${id}`} class="text-[15px] text-ink-soft transition-colors duration-200 hover:text-ink">
              {labels[id]}
            </a>
          </li>
        ))
      }
      {
        hasContact && (
          <li class="hidden sm:block">
            <a
              href="#contact"
              class="rounded-full border-[1.5px] border-ink px-4 py-1.75 text-[15px] text-ink transition-colors duration-200 hover:bg-ink hover:text-bg"
            >
              {labels.contact}
            </a>
          </li>
        )
      }
      <li class="ml-auto flex items-center gap-2">
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
