---
import { getCollection } from 'astro:content';
import { getLang, useTranslations } from '../i18n/ui';
import Section from './Section.astro';

const t = useTranslations(getLang(Astro.currentLocale));

const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
---

<Section id="publications" title={t('pubs.title')}>
  <ul class="flex flex-col">
    {
      pubs.map(({ data: pub }) => (
        <li class="reveal grid grid-cols-1 gap-1 border-t border-line py-7 first:border-t-0 first:pt-0 sm:grid-cols-[90px_minmax(0,1fr)] sm:gap-4">
          <span class="pt-1.25 font-mono text-[14px] text-accent">{pub.year}</span>
          <div>
            <h3 class="max-w-[44ch] font-head text-[22px] leading-[1.25] font-medium tracking-[-.015em]">{pub.title}</h3>
            <p class="mt-2 mb-1.5 text-[15px] text-ink-soft">
              {pub.authors} · {pub.venue}
            </p>
            <a
              href={`https://doi.org/${pub.doi}`}
              target="_blank"
              rel="noopener"
              class="font-mono text-[13px] break-all text-accent underline underline-offset-3"
            >
              doi:{pub.doi}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
