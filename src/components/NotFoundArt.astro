---
// 404 illustration: a chip whose middle trace is cut and leads to a missing pad.
// Same banner style and paint vocabulary as the project cards.
import { pa } from './project-art/paint';
---

<div
  aria-hidden="true"
  class="overflow-hidden rounded-card border border-line bg-bg bg-[radial-gradient(var(--color-line)_1px,transparent_1px)] bg-size-[14px_14px]"
>
  <svg viewBox="0 24 360 172" focusable="false" stroke-linecap="round" stroke-linejoin="round" class="block h-auto w-full">
    <!-- pins -->
    <path class={pa.trace} d="M75 44V60M100 44V60M125 44V60M75 160V176M100 160V176M125 160V176M34 85H50M34 110H50M34 135H50" />
    <path class={pa.dots} d="M75 44h.01M100 44h.01M125 44h.01M75 176h.01M100 176h.01M125 176h.01M34 85h.01M34 110h.01M34 135h.01" />
    <!-- chip -->
    <rect class={pa.panel} x="50" y="60" width="100" height="100" rx="10" />
    <rect class={pa.fillA} x="66" y="78" width="40" height="6" rx="3" />
    <rect class={pa.dim} x="66" y="94" width="62" height="3" rx="1.5" />
    <rect class={pa.dim} x="66" y="103" width="48" height="3" rx="1.5" />
    <circle class={pa.fillM} cx="134" cy="144" r="3" />
    <!-- intact traces, each ending on a pad -->
    <path class={pa.trace} d="M150 85H198L218 65H300M150 135H198L218 155H300" />
    <circle class={pa.ringA} cx="308" cy="65" r="7" />
    <circle class={pa.ringA} cx="308" cy="155" r="7" />
    <!-- the cut trace -->
    <path class={pa.strokeA} d="M150 110H232" />
    <path class={pa.ringM} d="M245 103l14 14M259 103l-14 14" />
    <path class:list={[pa.stroke, pa.dash, pa.faint]} d="M272 110H298" />
    <circle class:list={[pa.stroke, pa.dash]} cx="308" cy="110" r="7" />
  </svg>
</div>
